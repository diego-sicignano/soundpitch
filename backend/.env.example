# Copy to backend/.env and fill in. The backend reads process environment variables,
# so load the file into the shell that starts uvicorn (see README, "Configuration").

# scripted (default, offline) | replay (recorded Foundry replies, no network; what the Docker image runs)
# | bad_then_good | always_bad (test scenarios) | foundry (needs the two settings below and requirements-agents.txt)
SOUNDPITCH_LLM=scripted

# plain (default) | workflow (the Agent Framework graph; needs requirements-agents.txt)
SOUNDPITCH_ORCHESTRATOR=plain

# Azure AI Speech (neural voices). Leave empty to use the browser voice only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Brakes on POST /api/tts (SPEC section 8). They live in the memory of one process and restart at zero:
# they are not a spending cap. The pricing tier of the Speech resource is the only hard cap.
# Defaults: 30 requests a minute per client, 120 for the process, 60000 characters a day, 300000 a month.
SOUNDPITCH_TTS_PER_CLIENT_PER_MINUTE=
SOUNDPITCH_TTS_PER_MINUTE=
SOUNDPITCH_TTS_CHARS_PER_DAY=
SOUNDPITCH_TTS_CHARS_PER_MONTH=
# 1 only behind exactly one trusted proxy that appends the caller's address to X-Forwarded-For.
SOUNDPITCH_TRUST_PROXY=

# Microsoft Foundry, read when SOUNDPITCH_LLM=foundry. Sign in with `az login`; no key is used.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# Cost limits for the model, kept in one SQLite file so they survive restarts (D11). Empty = the default.
# Change them with care: the monthly ceiling cannot be set above 4.00 (the Azure budget of 5 EUR only alerts).
# Defaults: 2 calls a minute, 20 a day, 120000 tokens a day, 2.00 EUR of estimated spend a month.
SOUNDPITCH_LLM_CALLS_PER_MINUTE=
SOUNDPITCH_LLM_CALLS_PER_DAY=
SOUNDPITCH_LLM_TOKENS_PER_DAY=
SOUNDPITCH_LLM_EUR_PER_MONTH=
# Default backend/data/usage.sqlite (git-ignored); one file per host.
SOUNDPITCH_USAGE_DB=
