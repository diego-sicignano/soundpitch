# Copy to backend/.env and fill in. The backend reads process environment variables,
# so load the file into the shell that starts uvicorn (see README, "Configuration").

# scripted (default, offline) | bad_then_good | always_bad | foundry (planned, see ROADMAP.md)
SOUNDPITCH_LLM=scripted

# Azure AI Speech (neural voices). Leave empty to use the browser voice only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Cost guard for POST /api/tts, requests per minute per process.
SOUNDPITCH_TTS_PER_MINUTE=120

# Microsoft Foundry (planned, not read by the code yet).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
